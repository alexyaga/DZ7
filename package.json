{
  "name": "ai-meeting-analyzer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:backend": "node --use-system-ca --env-file-if-exists=.env --watch backend/src/server.js",
    "dev:demo": "node --use-system-ca --env-file-if-exists=.env backend/src/demoServer.js",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js"
  },
  "dependencies": {
    "@fontsource/manrope": "5.2.8",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "file-type": "^22.3.0",
    "lucide-react": "0.468.0",
    "multer": "2.5.0",
    "openai": "7.54.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "write-file-atomic": "^8.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.7"
  }
}
